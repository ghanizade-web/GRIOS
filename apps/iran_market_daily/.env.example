# Copy to .env locally. Never commit .env or put this key in chat.
FUNDAI_API_KEY=

# Set an explicit maximum before the scanner makes paid requests. Default 0 = no paid calls.
FUNDAI_MAX_DAILY_CREDITS=0

# Comma-separated symbols/slugs, e.g. فولاد,فملی,شپنا
IRAN_EQUITY_SYMBOLS=

# Daily bar freshness limit; FundAI sessions are dated in Tehran time.
IRAN_MAX_SESSION_AGE_DAYS=5
