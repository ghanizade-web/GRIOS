# Copy to .env locally. Never commit .env or put this key in chat.
FUNDAI_API_KEY=

# Pilot ceiling: 3 symbols × 6 credits (30 adjusted sessions) + 15 for market flow.
FUNDAI_MAX_DAILY_CREDITS=33

# Small pilot basket; edit locally if you want a different universe.
IRAN_EQUITY_SYMBOLS=فولاد,فملی,شپنا

# Daily bar freshness limit; FundAI sessions are dated in Tehran time.
IRAN_MAX_SESSION_AGE_DAYS=5
