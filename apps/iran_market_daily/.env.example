# Copy to .env locally. Never commit .env or put this key in chat.
FUNDAI_API_KEY=

# One 20-result market screener page (25) + three adjusted 30-session histories (18)
# + one market-flow row (15) = 58 credits on a Tehran trading day.
FUNDAI_MAX_DAILY_CREDITS=58

# Broad-market screener; validate the top three fresh, non-halted candidates.
IRAN_CANDIDATE_VALIDATION_COUNT=3

# Daily bar freshness limit; FundAI sessions are dated in Tehran time.
IRAN_MAX_SESSION_AGE_DAYS=5
